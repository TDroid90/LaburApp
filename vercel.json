{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/mobile/dist",
  "installCommand": "npm ci",
  "framework": null,
  "functions": {
    "api/drive-sync.mjs": { "maxDuration": 60 },
    "api/sheets-mirror.mjs": { "maxDuration": 30 },
    "api/credential-retention.mjs": { "maxDuration": 60 },
    "api/registry-lookup.mjs": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/credential-retention", "schedule": "17 3 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
