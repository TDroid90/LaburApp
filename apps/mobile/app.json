{
  "expo": {
    "name": "LaburApp",
    "slug": "trabajapp",
    "scheme": "laburapp",
    "version": "0.9.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "LaburApp usa las fotos que elijas para tu perfil, trabajos y solicitudes de presupuesto.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LaburApp usa la cámara únicamente para confirmar trabajos mediante un código QR.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/with-security-hardening"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alsema.laburapp"
    },
    "android": {
      "package": "com.alsema.laburapp",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64c4e0db-863a-4d9b-baaa-3640211ec1c8"
      }
    },
    "owner": "tdroid90s-team"
  }
}
